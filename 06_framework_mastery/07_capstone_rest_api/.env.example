# Example configuration. Copy it, then change the values:
#   - for docker compose: cp .env.example .env
#   - for cargo run:      APP_CONFIG_FILE=path/to/your/copy cargo run -p capstone_rest_api
# Real environment variables always win over this file.
# Every value here is an EXAMPLE. Never commit a file with real secrets.

APP_HOST=127.0.0.1
APP_PORT=8080

# sqlite::memory: forgets everything when the server stops.
# For a file that persists, e.g.: sqlite:capstone.db?mode=rwc
DATABASE_URL=sqlite::memory:

# At least 32 bytes. Generate one, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-in-production-change-me-in-production
JWT_ISSUER=capstone-rest-api
TOKEN_TTL_SECONDS=3600

# Argon2id cost (OWASP's suggestion). Lower ONLY in tests.
PASSWORD_MEMORY_KIB=19456
PASSWORD_ITERATIONS=2

# These addresses become admins when they register (comma-separated).
ADMIN_EMAILS=admin@example.com

REQUEST_TIMEOUT_SECONDS=10

# pretty (people) or json (log collectors). RUST_LOG must be a real
# environment variable, e.g. RUST_LOG=debug; it is not read from this file.
LOG_FORMAT=pretty
