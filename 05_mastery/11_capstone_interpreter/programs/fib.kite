// Fibonacci numbers, two ways: recursion (simple, slow) and a loop (fast).

fn fib(n) {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn fib_loop(n) {
    let a = 0;
    let b = 1;
    let i = 0;
    while i < n {
        let next = a + b;
        a = b;
        b = next;
        i = i + 1;
    }
    return a;
}

let i = 0;
while i <= 10 {
    print("fib(" + str(i) + ") =", fib(i));
    i = i + 1;
}
print("fib_loop(50) =", fib_loop(50));
