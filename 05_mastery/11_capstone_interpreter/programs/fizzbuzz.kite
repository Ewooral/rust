// FizzBuzz: Kite has no % operator yet (exercise 4 adds one),
// so "divisible by" is written with division and multiplication.

fn divisible(n, by) {
    let times = 0;
    while (times + 1) * by <= n {
        times = times + 1;
    }
    return times * by == n;
}

let n = 1;
while n <= 15 {
    if divisible(n, 15) {
        print("FizzBuzz");
    } else if divisible(n, 3) {
        print("Fizz");
    } else if divisible(n, 5) {
        print("Buzz");
    } else {
        print(n);
    }
    n = n + 1;
}
