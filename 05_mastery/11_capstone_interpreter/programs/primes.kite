// Prime numbers below 50: early `return` from inside a loop, `and`,
// and a function used before the line that defines it is reached
// (fine, because it's only CALLED after both are defined).

fn is_prime(n) {
    if n < 2 {
        return false;
    }
    let d = 2;
    while d * d <= n {
        if divisible(n, d) {
            return false;
        }
        d = d + 1;
    }
    return true;
}

fn divisible(n, d) {
    let rest = n;
    while rest >= d {
        rest = rest - d;
    }
    return rest == 0;
}

let found = "";
let n = 2;
while n < 50 {
    if is_prime(n) and n != 2 {
        found = found + str(n) + " ";
    }
    n = n + 1;
}
print("odd primes below 50:", found);
